# Sao chép file này thành .env.local và điền giá trị thật.
# Lấy trong Supabase: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CHỈ dùng ở server (API routes). Tuyệt đối không đưa vào code client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email các tài khoản được vào trang /admin (cách nhau bằng dấu phẩy)
ADMIN_EMAILS=admin@example.com

# SMTP để gửi email link Google Meet cho khách (xem README mục "Gửi email")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Ryry Tarot <your-email@gmail.com>"
